<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>chessbot_sim_ros</name>
  <version>0.1.0</version>
  <description>chess_brain playing in the MuJoCo simulation (chessbot_sim) over ROS 2: one node that is the camera, the arm, the opponent and the operator.</description>
  <maintainer email="todo@todo.todo">David Zeng</maintainer>
  <license>TODO: License declaration</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>chess_brain</exec_depend>
  <!-- Not ROS packages: the chessbot_sim package of this repository (imported from the checkout,
       see paths.py) and its Python dependencies (mujoco, ultralytics, opencv, scipy): scripts/setup_sim_deps.sh -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
